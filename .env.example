# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
SESSION_SECRET="replace-with-a-long-random-server-secret"

# Optional AI/OCR provider. The browser's core demo agent is deterministic and
# local-first. Configure a compatible provider only when its deployment is
# available; never commit keys or unrestricted database credentials.
AI_PROVIDER="demo"
RUNTIME_AGENT_MODEL="deterministic-demo-0b"
OPEN_WEIGHT_MODEL_ENDPOINT=""

# OAuth providers are intentionally optional in the demo. Add callback URLs
# and client secrets in the deployment environment, not in source control.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Register these exact callback URLs with each provider. For local development:
# Google:    http://localhost:3000/auth/google/callback
# GitHub:    http://localhost:3000/auth/github/callback
# Microsoft: http://localhost:3000/auth/microsoft/callback
# In deployment, replace localhost:3000 with APP_URL.
# The browser uses same-origin /api/auth/* requests in local development and production.
